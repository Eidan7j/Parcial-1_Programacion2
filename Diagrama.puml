@startuml
' Tema y configuración
skinparam classAttributeIconSize 0

' Enums
enum Disponibilidad {
  DISPONIBLE
  NO_DISPONIBLE
}

enum NivelReferencia {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum TipoEstudiante {
  NINO
  ADOLESCENTE
  ADULTO
}

enum EstadoCurso {
  ACTIVO
  SUSPENDIDO
  FINALIZADO
}

' Clases principales
class Academia {
  - nombreComercial : String
  - NIT : String
  - direccion : String
  - telefono : String
  - correoElectronico : String
  - paginaWeb : String
  --
  + registrarEstudiante(nombre:String, documento:String, telefono:String, correo:String, edad:int, fechaRegistro:Date)
  + eliminarEstudiante(documento:String)
  + buscarEstudiante(documento:String) : Estudiante
  + registrarProfesor(nombre:String, idioma:String, descripcion:String, duracionMeses:int, valorMensual:double, estado:EstadoCurso)
  + eliminarCurso(codigo:String) : Curso
  + registrarServicioAdicional(codigo:String, nombre:String, descripcion:String, precio:double, disponibilidad:Disponibilidad)
  + eliminarServicioAdicional(codigo:String)
  + buscarServicioAdicional(codigo:String) : ServicioAdicional
}

class ServicioAdicional {
  - codigoServicioAdicional : String
  - nombreServicioAdicional : String
  - precioServicioAdicional : double
  - disponibilidadServicioAdicional : Disponibilidad
  --
  + ServicioAdicional()
}

class Reporte {
  --
  + generarReporteIngresos(fechaInicio:Date, fechaFin:Date) : double
  + generarReporteEstudiantesActivos() : List<Estudiante>
}

class Matricula {
  - fechaMatricula : Date
  - valorTotalMatricula : double
  --
  + Matricula()
  + calcularValorTotalMatricula() : double
  + agregarServicioAdicional(servicio:ServicioAdicional)
  + registrarPago(pago:Pago)
}

class Pago {
  - idPago : String
  - montoPago : double
  - fechaPago : Date
  --
  + Pago()
  + registrarPago(idPago:String, monto:double, fecha:Date)
}

class Estudiante {
  - nombreEstudiante : String
  - documentoEstudiante : String
  - tipoEstudiante : TipoEstudiante
  - nivelReferencia : NivelReferencia
  - edadEstudiante : int
  - fechaRegistroEstudiante : Date
  --
  + Estudiante()
  + actualizarDatosEstudiante(telefono:String, correo:String, edad:int)
}

class Profesor {
  - identificacionProfesor : String
  - nombreProfesor : String
  - idiomaProfesor : String
  - telefonoProfesor : String
  - tarifaSesionProfesor : double
  --
  + Profesor()
  + actualizarProfesor(telefono:String, tarifaSesion:double)
}

class Curso {
  - codigoCurso : String
  - nombreCurso : String
  - descripcionCurso : String
  - duracionMesesCurso : int
  - valorMensualCurso : double
  - estadoCurso : EstadoCurso
  --
  + Curso()
  + asignarTipoEnsenanza(tipo:String) : void
}

class CursoIngles {
  - nivelIngles : String
  - horasIngles : String
  --
  + asignarTipoEnsenanza(tipo:String) : void
}

class CursoFrances {
  - nivelFrances : String
  - horasFrances : String
  --
  + asignarTipoEnsenanza(tipo:String) : void
}

class CursoPortugues {
  - nivelPortugues : String
  - horasPortugues : String
  --
  + asignarTipoEnsenanza(tipo:String) : void
}

class CursoPersonalizado {
  - cantidadSesiones : int
  - nivelReferencia : NivelReferencia
  --
  + CursoPersonalizado()
  + mostrarRelacionEstudianteCursoProfesor(estudiante:Estudiante, curso:CursoPersonalizado, profesor:Profesor) : String
  + asignarTipoEnsenanza(tipo:String) : void
}

' Relaciones y multiplicidades (navegación)
Academia "1" o-- "0..*" Estudiante : listaEstudiantes
Academia "1" o-- "0..*" Profesor : listaProfesores
Academia "1" o-- "0..*" Curso : listaCursos
Academia "1" o-- "0..*" ServicioAdicional : listaServiciosAdicionales
Academia "1" o-- "0..*" Matricula : listaMatriculas
Academia "1" o-- "1" Reporte : reporte

Matricula "1" o-- "0..*" Pago : listaPagos
Matricula "1" o-- "0..*" ServicioAdicional : serviciosAdicionales
Matricula "1" --> "1" Estudiante : estudiante
Matricula "1" --> "1" Curso : curso
Matricula "0..1" --> "0..1" Profesor : profesorAsignado

Curso <|-- CursoIngles
Curso <|-- CursoFrances
Curso <|-- CursoPortugues
Curso <|-- CursoPersonalizado

' Asociaciones adicionales
Profesor "0..*" -- "0..*" Curso : dicta
Estudiante "0..*" -- "0..*" Curso : inscrito_en
ServicioAdicional "0..*" -- "0..*" Curso : aplica_a

@enduml
