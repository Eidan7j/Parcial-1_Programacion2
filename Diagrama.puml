@startuml
title Diagrama de Clases - Academia de Idiomas LenguajeCafetero

' ==========================================
' ENUMS
' ==========================================
enum EstadoCurso {
    ACTIVO
    SUSPENDIDO
    FINALIZADO
}

enum TipoCurso {
    REGULAR
    INTENSIVO
    PERSONALIZADO
}

enum Nivel {
    A1
    A2
    B1
    B2
    C1
    C2
}

enum Disponibilidad {
    DISPONIBLE
    NO_DISPONIBLE
}

' ==========================================
' CLASES DEL MODELO
' ==========================================
class LenguajeCafetero {
    - nombreComercial : String
    - nit : String
    - direccion : String
    - telefono : String
    - correoElectronico : String
    - paginaWeb : String
    + LenguajeCafetero(nombreComercial, nit, direccion, telefono, correo, web)
    + registrarEstudiante(estudiante : Estudiante) : boolean
    + buscarEstudiante(documentoIdentidad : String) : Estudiante
    + actualizarEstudiante(estudiante : Estudiante) : boolean
    + eliminarEstudiante(documento : String) : boolean
    + registrarProfesor(profesor : Profesor) : boolean
    + buscarProfesorPorIdentificacion(id : String) : Optional<Profesor>
    + registrarCurso(curso : Curso) : boolean
    + registrarServicioAdicional(servicio : ServicioAdicional) : boolean
    + registrarMatricula(matricula : Matricula) : boolean
    + calcularIngresosPeriodo(fechaInicial : LocalDate, fechaFinal : LocalDate) : double
    + generarReporteIngresos(fechaInicial : LocalDate, fechaFinal : LocalDate) : Reporte
    + cargarDatosPrueba() : void
}

class Estudiante {
    - documentoIdentidad : String
    - nombreCompleto : String
    - telefono : String
    - correoElectronico : String
    - edad : int
    - fechaRegistro : LocalDate
    + Estudiante(documento, nombre, telefono, correo, edad, fechaRegistro)
    + getDocumentoIdentidad() : String
    + getNombreCompleto() : String
    + getEdad() : int
}

class Profesor {
    - identificacion : String
    - nombre : String
    - idioma : String
    - telefono : String
    - tarifaSesion : double
    + Profesor(identificacion, nombre, idioma, telefono, tarifaSesion)
    + getTarifaSesion() : double
}

abstract class Curso {
    - codigo : String
    - nombre : String
    - idioma : String
    - descripcion : String
    - duracionMeses : int
    - valorMensual : double
    - estadoCurso : EstadoCurso
    - tipoCurso : TipoCurso
    - beneficios : List<String>
    + Curso(codigo, nombre, idioma, descripcion, duracion, valorMensual, estado, tipo)
    + {abstract} calcularCostoBase(profesor : Profesor) : double
    + agregarBeneficio(beneficio : String) : void
    + getBeneficiosFormateados() : String
}

class CursoRegular {
    + CursoRegular(codigo, nombre, idioma, descripcion, duracion, valorMensual, estado)
    + calcularCostoBase(profesor : Profesor) : double
}

class CursoIntensivo {
    + CursoIntensivo(codigo, nombre, idioma, descripcion, duracion, valorMensual, estado)
    + calcularCostoBase(profesor : Profesor) : double
}

class CursoPersonalizado {
    - cantidadSesiones : int
    - nivelReferencia : Nivel
    - objetivosEstudiante : String
    + CursoPersonalizado(codigo, nombre, idioma, descripcion, duracion, valorMensual, estado, sesiones, nivel, objetivos)
    + calcularCostoBase(profesor : Profesor) : double
}

class ServicioAdicional {
    - codigo : String
    - nombre : String
    - descripcion : String
    - precio : double
    - disponibilidad : Disponibilidad
    + ServicioAdicional(codigo, nombre, descripcion, precio, disponibilidad)
    + estaDisponible() : boolean
}

class Matricula {
    - codigo : String
    - fecha : LocalDate
    - descuentoPorcentaje : double
    + Matricula(codigo, fecha, estudiante, curso, profesor, descuento)
    + calcularCostoCurso() : double
    + calcularCostoServicios() : double
    + calcularSubtotal() : double
    + calcularMontoDescuento() : double
    + calcularValorTotal() : double
    + agregarServicioAdicional(servicio : ServicioAdicional) : void
    + agregarPago(pago : Pago) : void
    + getTotalPagado() : double
    + getSaldoPendiente() : double
}

class Pago {
    - idPago : String
    - monto : double
    - fechaPago : LocalDate
    - metodoPago : String
    + Pago(idPago, monto, fechaPago, metodoPago)
}

class Reporte {
    - fechaInicial : LocalDate
    - fechaFinal : LocalDate
    - totalIngresos : double
    - cantidadMatriculas : int
    + Reporte(fechaInicial, fechaFinal, matriculas)
    + getTotalIngresos() : double
    + getCantidadMatriculas() : int
}

' ==========================================
' RELACIONES
' ==========================================
LenguajeCafetero "1" *-- "*" Estudiante : administra
LenguajeCafetero "1" *-- "*" Profesor : administra
LenguajeCafetero "1" *-- "*" Curso : administra
LenguajeCafetero "1" *-- "*" ServicioAdicional : administra
LenguajeCafetero "1" *-- "*" Matricula : administra

Curso <|-- CursoRegular
Curso <|-- CursoIntensivo
Curso <|-- CursoPersonalizado

Curso --> EstadoCurso
Curso --> TipoCurso
CursoPersonalizado --> Nivel
ServicioAdicional --> Disponibilidad

Matricula --> "1" Estudiante : pertenece a
Matricula --> "1" Curso : inscribe
Matricula --> "0..1" Profesor : asigna (responsable)
Matricula o-- "*" ServicioAdicional : incluye
Matricula "1" *-- "*" Pago : registra

Reporte o-- "*" Matricula : resume

@enduml
