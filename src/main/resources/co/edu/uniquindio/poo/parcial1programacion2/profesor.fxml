<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.poo.parcial1programacion2.controllers.ProfesorController"
            style="-fx-background-color: #f8fafc;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #065f46; -fx-padding: 15 25 15 25;">
            <Button text="⬅ Volver al Menú" onAction="#volverAlInicio"
                    style="-fx-background-color: #ffffff; -fx-text-fill: #065f46; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Label text="MÓDULO DE GESTIÓN DE PROFESORES"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <left>
        <VBox spacing="12" prefWidth="340" style="-fx-background-color: white; -fx-padding: 18; -fx-border-color: #e2e8f0;">
            <Label text="Crear / Buscar Profesor" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>

            <GridPane hgap="8" vgap="10">
                <columnConstraints>
                    <ColumnConstraints prefWidth="110"/>
                    <ColumnConstraints prefWidth="190"/>
                </columnConstraints>

                <Label text="ID Profesor:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtIdProfesor" promptText="Ej: P001" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Nombre:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtNombreProfesor" promptText="Nombre completo" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Idioma:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="txtIdiomaProfesor" promptText="Ej: Inglés, Francés..." GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Teléfono:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="txtTelefonoProfesor" promptText="Ej: 3124567890" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Tarifa Sesión:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="txtTarifaSesion" promptText="Ej: 80000" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="8">
                <Button text="Registrar" onAction="#registrarProfesor" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Button text="Buscar" onAction="#buscarProfesor" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </HBox>

            <HBox spacing="8">
                <Button text="Eliminar" onAction="#eliminarProfesor" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Button text="Limpiar" onAction="#limpiarCampos" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </HBox>

            <Separator/>

            <Label text="Actualizar Profesor" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <ComboBox fx:id="cbCampoActualizar" promptText="Seleccione campo" maxWidth="Infinity"/>
            <TextField fx:id="txtNuevoValor" promptText="Nuevo valor"/>
            <Button text="Actualizar Profesor" onAction="#actualizarDatosProfesor" maxWidth="Infinity"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="12" style="-fx-padding: 18;">
            <Label text="Listado de Profesores" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <TableView fx:id="tablaProfesores" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="90"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180"/>
                    <TableColumn fx:id="colIdioma" text="Idioma" prefWidth="130"/>
                    <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="130"/>
                    <TableColumn fx:id="colTarifa" text="Tarifa por Sesión" prefWidth="140"/>
                </columns>
            </TableView>
            <Label fx:id="lblMensaje" text="Seleccione o registre un profesor." style="-fx-font-size: 13px;"/>
        </VBox>
    </center>

</BorderPane>
