<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.poo.parcial1programacion2.controllers.MatriculaController"
            stylesheets="@styles.css"
            style="-fx-background-color: #f8fafc;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #991b1b; -fx-padding: 15 25 15 25;">
            <Button text="⬅ Volver al Menú" onAction="#volverAlInicio"
                    style="-fx-background-color: #ffffff; -fx-text-fill: #991b1b; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Label text="MÓDULO DE GESTIÓN DE MATRÍCULAS"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <left>
        <VBox spacing="12" prefWidth="350" style="-fx-background-color: white; -fx-padding: 18; -fx-border-color: #e2e8f0;">
            <Label text="Crear Nueva Matrícula" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>

            <GridPane hgap="8" vgap="10">
                <columnConstraints>
                    <ColumnConstraints prefWidth="115"/>
                    <ColumnConstraints prefWidth="195"/>
                </columnConstraints>

                <Label text="Código Matrícula:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtCodigoMatricula" promptText="Ej: M002" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Fecha Matrícula:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <DatePicker fx:id="dpFechaMatricula" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Estudiante:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbEstudiante" promptText="Seleccione estudiante" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Curso:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbCurso" promptText="Seleccione curso" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="8">
                <Button text="Registrar Matrícula" onAction="#registrarMatricula" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Button text="Limpiar" onAction="#limpiarCampos" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </HBox>

            <Separator/>

            <Label text="Agregar Servicio Adicional a Matrícula" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <Label text="(Seleccione una matrícula de la tabla)" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
            <ComboBox fx:id="cbServicioAdicional" promptText="Seleccione servicio adicional" maxWidth="Infinity"/>
            <Button text="Agregar Servicio a Matrícula" onAction="#agregarServicioAMatricula" maxWidth="Infinity"
                    style="-fx-background-color: #d97706; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>

            <Separator/>

            <Button text="Calcular Valor Total Matrícula" onAction="#calcularTotalMatricula" maxWidth="Infinity"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>

            <Button text="Ir a Vista de Pagos ➡" onAction="#irAVistaPagos" maxWidth="Infinity"
                    style="-fx-background-color: #0891b2; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="12" style="-fx-padding: 18;">
            <Label text="Listado de Matrículas Registradas" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <TableView fx:id="tablaMatriculas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCodigo" text="Código" prefWidth="80"/>
                    <TableColumn fx:id="colFecha" text="Fecha" prefWidth="90"/>
                    <TableColumn fx:id="colEstudiante" text="Estudiante" prefWidth="140"/>
                    <TableColumn fx:id="colCurso" text="Curso" prefWidth="140"/>
                    <TableColumn fx:id="colServicios" text="Servicios Adicionales" prefWidth="190"/>
                    <TableColumn fx:id="colTotalPagado" text="Total Pagado ($)" prefWidth="120"/>
                </columns>
            </TableView>
            <Label fx:id="lblMensaje" text="Seleccione o registre una matrícula." style="-fx-font-size: 13px;"/>
        </VBox>
    </center>

</BorderPane>
