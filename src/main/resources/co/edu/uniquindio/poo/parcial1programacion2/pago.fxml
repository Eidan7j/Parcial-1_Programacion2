<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.poo.parcial1programacion2.controllers.PagoController"
            style="-fx-background-color: #f8fafc;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #155e75; -fx-padding: 15 25 15 25;">
            <Button text="⬅ Volver al Menú" onAction="#volverAlInicio"
                    style="-fx-background-color: #ffffff; -fx-text-fill: #155e75; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Label text="MÓDULO DE REGISTRO Y GESTIÓN DE PAGOS"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <left>
        <VBox spacing="12" prefWidth="350" style="-fx-background-color: white; -fx-padding: 18; -fx-border-color: #e2e8f0;">
            <Label text="Seleccionar Matrícula" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <ComboBox fx:id="cbMatricula" promptText="Seleccione una matrícula" maxWidth="Infinity"/>

            <Separator/>

            <Label text="Datos del Pago" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <GridPane hgap="8" vgap="10">
                <columnConstraints>
                    <ColumnConstraints prefWidth="105"/>
                    <ColumnConstraints prefWidth="205"/>
                </columnConstraints>

                <Label text="ID Pago:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtIdPago" promptText="Ej: PAG-02" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Monto ($):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtMontoPago" promptText="Ej: 150000" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Fecha Pago:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <DatePicker fx:id="dpFechaPago" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>

            <Button text="Registrar Nuevo Pago" onAction="#registrarPago" maxWidth="Infinity"
                    style="-fx-background-color: #0891b2; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>

            <Button text="Modificar Pago Seleccionado" onAction="#modificarPagoExistente" maxWidth="Infinity"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>

            <Button text="Limpiar" onAction="#limpiarCampos" maxWidth="Infinity"
                    style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="12" style="-fx-padding: 18;">
            <Label fx:id="lblTotalMatricula" text="Total acumulado de la matrícula: $0.0"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #155e75;"/>
            <TableView fx:id="tablaPagos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colIdPago" text="ID Pago" prefWidth="150"/>
                    <TableColumn fx:id="colMontoPago" text="Monto del Pago ($)" prefWidth="200"/>
                    <TableColumn fx:id="colFechaPago" text="Fecha del Pago" prefWidth="180"/>
                </columns>
            </TableView>
            <Label fx:id="lblMensaje" text="Seleccione una matrícula y registre o actualice pagos." style="-fx-font-size: 13px;"/>
        </VBox>
    </center>

</BorderPane>
