<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.poo.parcial1programacion2.controllers.EstudianteController"
            stylesheets="@styles.css"
            style="-fx-background-color: #f8fafc;">


    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #1e3a8a; -fx-padding: 15 25 15 25;">
            <Button text="⬅ Volver al Menú" onAction="#volverAlInicio"
                    style="-fx-background-color: #ffffff; -fx-text-fill: #1e3a8a; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Label text="MÓDULO DE GESTIÓN DE ESTUDIANTES (Builder &amp; Prototype)"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <left>
        <VBox spacing="10" prefWidth="340" style="-fx-background-color: white; -fx-padding: 18; -fx-border-color: #e2e8f0;">
            <Label text="Crear / Buscar Estudiante" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>

            <GridPane hgap="8" vgap="8">
                <columnConstraints>
                    <ColumnConstraints prefWidth="110"/>
                    <ColumnConstraints prefWidth="190"/>
                </columnConstraints>

                <Label text="Documento:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtDocumento" promptText="Ej: 123456789" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Nombre:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtNombre" promptText="Nombre completo" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Teléfono:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="txtTelefono" promptText="Ej: 3124567890" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Correo:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="txtCorreo" promptText="correo@ejemplo.com" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Edad:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="txtEdad" promptText="Ej: 20" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <Label text="Fecha Registro:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <DatePicker fx:id="dpFechaRegistro" maxWidth="Infinity" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <Label text="Nivel MCER:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbNivelReferencia" promptText="Seleccione nivel" maxWidth="Infinity" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                <Label text="Categoría:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbTipoEstudiante" promptText="Seleccione tipo" maxWidth="Infinity" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="8">
                <Button text="Registrar" onAction="#registrarEstudiante" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Button text="Buscar" onAction="#buscarEstudiante" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </HBox>

            <HBox spacing="8">
                <Button text="Eliminar" onAction="#eliminarEstudiante" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Button text="Limpiar" onAction="#limpiarCampos" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </HBox>

            <Button text="Clonar Seleccionado (Patrón Prototype)" onAction="#clonarEstudiantePrototype" maxWidth="Infinity"
                    style="-fx-background-color: #7c3aed; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>

            <Separator/>

            <Label text="Actualizar Dato Específico" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <ComboBox fx:id="cbCampoActualizar" promptText="Campo a modificar" maxWidth="Infinity"/>
            <TextField fx:id="txtNuevoValor" promptText="Nuevo valor"/>
            <Button text="Actualizar Dato" onAction="#actualizarDatoEstudiante" maxWidth="Infinity"
                    style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="12" style="-fx-padding: 18;">
            <Label text="Listado de Estudiantes Registrados" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <TableView fx:id="tablaEstudiantes" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colDocumento" text="Documento" prefWidth="100"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="140"/>
                    <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="95"/>
                    <TableColumn fx:id="colCorreo" text="Correo" prefWidth="150"/>
                    <TableColumn fx:id="colEdad" text="Edad" prefWidth="55"/>
                    <TableColumn fx:id="colNivel" text="Nivel" prefWidth="60"/>
                    <TableColumn fx:id="colTipo" text="Tipo" prefWidth="95"/>
                    <TableColumn fx:id="colFecha" text="Fecha Reg." prefWidth="85"/>
                </columns>
            </TableView>
            <Label fx:id="lblMensaje" text="Seleccione o registre un estudiante." style="-fx-font-size: 13px;"/>
        </VBox>
    </center>

</BorderPane>
