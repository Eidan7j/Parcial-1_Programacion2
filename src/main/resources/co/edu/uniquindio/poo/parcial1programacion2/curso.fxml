<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.poo.parcial1programacion2.viewController.CursoViewController"
            stylesheets="@styles.css"
            style="-fx-background-color: #f8fafc;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #4c1d95; -fx-padding: 15 25 15 25;">
            <Button text="⬅ Volver al Menú" onAction="#volverAlInicio"
                    style="-fx-background-color: #ffffff; -fx-text-fill: #4c1d95; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Label text="MÓDULO DE GESTIÓN DE CURSOS (Inglés, Francés, Portugués, Personalizado)"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <left>
        <ScrollPane fitToWidth="true" prefWidth="360" style="-fx-background-color: white;">
            <VBox spacing="9" style="-fx-background-color: white; -fx-padding: 16;">
                <Label text="Crear / Buscar Curso" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>

                <GridPane hgap="8" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="115"/>
                        <ColumnConstraints prefWidth="195"/>
                    </columnConstraints>

                    <Label text="Tipo de Curso:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cbTipoCurso" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Código Curso:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtCodigo" promptText="Ej: C004" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Nombre Curso:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtNombre" promptText="Nombre del curso" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Idioma:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtIdioma" promptText="Idioma" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Descripción:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtDescripcion" promptText="Descripción breve" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="Duración (meses):" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtDuracion" promptText="Ej: 6" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <Label text="Valor Mensual:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtValorMensual" promptText="Ej: 250000" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                    <Label text="Estado:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cbEstadoCurso" maxWidth="Infinity" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                </GridPane>

                <!-- Campos Curso Regular -->
                <VBox fx:id="boxCursoRegular" spacing="6" style="-fx-background-color: #f1f5f9; -fx-padding: 10; -fx-background-radius: 6;">
                    <Label text="Datos del Curso de Idioma" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="txtNivelRegular" promptText="Nivel (Ej: A1, B1, C1)"/>
                    <TextField fx:id="txtHorarioRegular" promptText="Horario (Ej: Lunes y Miércoles 6-8 PM)"/>
                </VBox>

                <!-- Campos Curso Personalizado -->
                <VBox fx:id="boxCursoPersonalizado" spacing="6" style="-fx-background-color: #ede9fe; -fx-padding: 10; -fx-background-radius: 6;">
                    <Label text="Datos del Curso Personalizado" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="txtCantidadSesiones" promptText="Cantidad de Sesiones (Ej: 10)"/>
                    <TextField fx:id="txtNivelPersonalizado" promptText="Nivel Referencia (Ej: B1)"/>
                    <TextField fx:id="txtTipoNivelEstudiante" promptText="Categoría (Ej: Adolescente / Adulto)"/>
                    <ComboBox fx:id="cbProfesor" promptText="Seleccione Profesor" maxWidth="Infinity"/>
                    <ComboBox fx:id="cbEstudiante" promptText="Seleccione Estudiante" maxWidth="Infinity"/>
                </VBox>

                <HBox spacing="8">
                    <Button text="Registrar" onAction="#registrarCurso" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #7c3aed; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    <Button text="Buscar" onAction="#buscarCurso" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>

                <HBox spacing="8">
                    <Button text="Eliminar" onAction="#eliminarCurso" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    <Button text="Limpiar" onAction="#limpiarCampos" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>

                <Separator/>
                <Label text="Asignar Modalidad (Polimorfismo)" style="-fx-font-weight: bold;"/>
                <TextField fx:id="txtModalidadEnsenanza" promptText="Ej: Virtual / Presencial"/>
                <Button text="Asignar Modalidad de Enseñanza" onAction="#asignarModalidadEnsenanza" maxWidth="Infinity"
                        style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </VBox>
        </ScrollPane>
    </left>

    <center>
        <VBox spacing="12" style="-fx-padding: 18;">
            <Label text="Catálogo de Cursos Registrados" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <TableView fx:id="tablaCursos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCodigo" text="Código" prefWidth="70"/>
                    <TableColumn fx:id="colTipo" text="Subclase" prefWidth="95"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="135"/>
                    <TableColumn fx:id="colIdioma" text="Idioma" prefWidth="80"/>
                    <TableColumn fx:id="colDuracion" text="Meses" prefWidth="55"/>
                    <TableColumn fx:id="colValor" text="Valor Mensual" prefWidth="100"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="85"/>
                    <TableColumn fx:id="colDetalle" text="Detalle / Relación" prefWidth="280"/>
                </columns>
            </TableView>
            <Label fx:id="lblMensaje" text="Seleccione o registre un curso." style="-fx-font-size: 13px;"/>
        </VBox>
    </center>

</BorderPane>
