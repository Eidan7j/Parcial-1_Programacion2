<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.poo.parcial1programacion2.controllers.ReporteController"
            style="-fx-background-color: #f8fafc;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #334155; -fx-padding: 15 25 15 25;">
            <Button text="⬅ Volver al Menú" onAction="#volverAlInicio"
                    style="-fx-background-color: #ffffff; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Label text="MÓDULO DE REPORTES E INGRESOS DE LA ACADEMIA"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <left>
        <VBox spacing="14" prefWidth="350" style="-fx-background-color: white; -fx-padding: 18; -fx-border-color: #e2e8f0;">
            <Label text="Filtrar Ingresos por Fechas" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>

            <Label text="Fecha de Inicio:"/>
            <DatePicker fx:id="dpFechaInicio" maxWidth="Infinity"/>

            <Label text="Fecha de Fin:"/>
            <DatePicker fx:id="dpFechaFin" maxWidth="Infinity"/>

            <Button text="Generar Reporte (Reporte.generarReporteIngresos)" onAction="#generarReportePorFechas" maxWidth="Infinity"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>

            <Separator/>

            <Button text="Consultar Ingresos Totales (Academia)" onAction="#mostrarIngresosTotalesAcademia" maxWidth="Infinity"
                    style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>

            <VBox spacing="8" style="-fx-background-color: #f1f5f9; -fx-padding: 12; -fx-background-radius: 8;">
                <Label fx:id="lblResultadoRango" wrapText="true" text="Ingresos en el rango: $0.0"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
                <Label fx:id="lblTotalGeneralAcademia" wrapText="true" text="El total de ingresos generados por la academia es: 0.0"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #065f46;"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="12" style="-fx-padding: 18;">
            <Label text="Matrículas Incluidas en el Rango de Fechas" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <TableView fx:id="tablaMatriculasRango" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCodigo" text="Código Matrícula" prefWidth="130"/>
                    <TableColumn fx:id="colFecha" text="Fecha Matrícula" prefWidth="120"/>
                    <TableColumn fx:id="colEstudiante" text="Estudiante" prefWidth="170"/>
                    <TableColumn fx:id="colCurso" text="Curso" prefWidth="170"/>
                    <TableColumn fx:id="colTotalPagado" text="Ingresos Matrícula ($)" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>
